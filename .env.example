# Raphael local auth (GitHub OAuth) example.
#
# OAuth App settings:
# - Application name: Raphael (Testamy)
# - Homepage URL: http://localhost:6274
# - Authorization callback URL: http://localhost:6274/api/auth/callback/github
#
# Org OAuth App creation page:
# https://github.com/organizations/Testamy/settings/applications/new

PORT=6274
RAPHAEL_HOST_BIND=127.0.0.1

RAPHAEL_AUTH_ENABLED=true
RAPHAEL_AUTH_EMAIL_PASSWORD_ENABLED=false
RAPHAEL_ALLOW_UNAUTH_ADMIN=false
RAPHAEL_ALLOW_FIRST_USER_ADMIN=false

# Promote this email to admin on sign-in (recommended for first login).
RAPHAEL_ADMIN_EMAIL=

# BetterAuth
BETTER_AUTH_BASE_URL=http://localhost:6274
RAPHAEL_AUTH_TRUSTED_ORIGINS=http://localhost:6274
RAPHAEL_CORS_ORIGINS=http://localhost:6274
RAPHAEL_TRUST_PROXY=loopback
BETTER_AUTH_SECRET=

# Ingest/query safety
RAPHAEL_INGEST_MAX_ITEMS=5000
RAPHAEL_INGEST_RATE_LIMIT_REQUESTS_PER_MINUTE=600
RAPHAEL_INGEST_RATE_LIMIT_ITEMS_PER_MINUTE=60000
RAPHAEL_INGEST_RATE_LIMIT_BURST_MULTIPLIER=2
RAPHAEL_SEARCH_ATTRIBUTES_ENABLED=false
RAPHAEL_WS_MAX_PAYLOAD_BYTES=65536
RAPHAEL_WS_MAX_BUFFERED_BYTES=1048576
RAPHAEL_PRUNE_COMPACT_AFTER_DELETE=true
RAPHAEL_SQLITE_FULL_VACUUM_MIN_FREE_PAGES=2048

# GitHub OAuth
RAPHAEL_AUTH_GITHUB_CLIENT_ID=
RAPHAEL_AUTH_GITHUB_CLIENT_SECRET=
