{
  "name": "raphael",
  "version": "1.0.0",
  "description": "Simple local trace and wide event viewer",
  "author": "Peter Olom <peter@olom.dev>",
  "homepage": "https://raphael.olom.dev",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "vite build",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "start": "node dist/server/index.js",
    "preview": "npm run build && npm run start",
    "seed:large": "tsx scripts/seed-large-dataset.ts",
    "perf:check": "tsx scripts/perf-check.ts",
    "test:pagination": "tsx scripts/pagination-smoke.ts",
    "test:retention": "tsx scripts/retention-smoke.ts",
    "test:retention-paths": "tsx scripts/retention-paths-smoke.ts"
  },
  "dependencies": {
    "better-auth": "^1.6.10",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "react-grid-layout": "^2.2.3",
    "react-resizable": "^3.1.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.2",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-resizable": "^3.0.8",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.2"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "packageManager": "npm@11.7.0"
}
